<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.3</version>
        <relativePath/>
    </parent>
    <groupId>ai.zenv.qudo</groupId>
    <artifactId>qudo-portal-backend</artifactId>
    <version>1.0.0</version>
    <name>Qudo Portal Backend</name>
    <description>JSON API backend for the Qudo developer portal — auth, sandbox proxying, demo requests</description>

    <properties>
        <java.version>17</java.version>
        <qudo.jni.version>1.0.0</qudo.jni.version>
        <!-- Directory containing libqudo_jni_crypto.{dylib,so}. Default assumes
             qudo-jni-crypto is checked out as a sibling repo. Override with:
             mvn -Dqudo.native.lib.path=/absolute/path spring-boot:run -->
        <qudo.native.lib.path>../qudo-jni-crypto/build</qudo.native.lib.path>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Security. Two filter chains (see SecurityConfig): public
             routes stay permit-all; /api/v1/admin/** requires an authenticated
             ROLE_ADMIN session (single admin credential supplied via env). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Persistence: Postgres + JPA + Flyway. Backing store for the product
             catalog + audit trail — the backend is the source of truth for which
             products are publicly visible. Versions managed by the Boot BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Qudo JNI crypto provider (FIPS 203/204/205 algorithms via OpenSSL).
             Installed locally from libs/ before build — see README for the
             one-time mvn install:install-file command. -->
        <dependency>
            <groupId>com.qudo</groupId>
            <artifactId>qudo-jni-crypto</artifactId>
            <version>${qudo.jni.version}</version>
        </dependency>

        <!-- Observability: Micrometer + Prometheus registry. Exposes
             /actuator/prometheus for scraping. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Structured JSON logging via logstash-logback-encoder (enabled by
             the "prod" Spring profile in logback-spring.xml). Spring Boot
             3.4+ has built-in JSON layouts but we're on 3.2.x. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>7.4</version>
        </dependency>

        <!-- ───── Test deps ───── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Security test support: @WithMockUser + csrf() postprocessor
             for the admin authorization slice tests. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers: a real Postgres for the @DataJpaTest product-catalog
             + Flyway-migration slice tests, which do NOT boot QudoCryptoService
             and so run without the native crypto lib. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Native Qudo JNI lib must be on java.library.path; the
                         packaged JAR run separately needs the same flag. -->
                    <jvmArguments>-Djava.library.path=${qudo.native.lib.path}</jvmArguments>
                    <!-- Pin the real entry point: the throwaway
                         com.pqc.verify.VerifyApp scaffold also has a main(),
                         and with two candidates spring-boot:run (and
                         repackage) refuse to guess. -->
                    <mainClass>com.pqc.PortalApplication</mainClass>
                </configuration>
            </plugin>
            <!-- Surefire (unit tests) and Failsafe (integration tests) need
                 the same -Djava.library.path so QudoCryptoService can load
                 the native lib at @PostConstruct time. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Djava.library.path=${qudo.native.lib.path}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
