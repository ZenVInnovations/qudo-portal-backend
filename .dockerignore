# Speed up `docker build` by excluding everything that isn't part of
# the build context. The build stages copy specifically what they need
# (libs/, pom.xml, src/) so anything else just bloats the context tar
# that's shipped to the docker daemon.

# Maven output
target/
**/target/

# Local dev artifacts
.env
.env.*
!.env.example
*.log
logs/

# IDE / OS
.idea/
.vscode/
.DS_Store
*.iml

# Git
.git/
.gitignore
.gitattributes

# CI
.github/

# Docs that don't affect the build
README.md
TROUBLESHOOTING.md
KEY_ROTATION.md
docs/

# Test outputs / coverage
.mvn/
coverage/
