# ============================================================================
# qudo-portal-backend — env-var template
# ============================================================================
# Copy this file to `.env` (gitignored) and fill in the SMTP credentials.
# Then load before launching the BE:
#
#     set -a; source .env; set +a; mvn spring-boot:run
#
# In IntelliJ / VS Code, add these as run-configuration env vars instead.
#
# ───── Profile activation ───────────────────────────────────────────────────
# Pick a Spring profile to tune logging + safety defaults:
#
#     SPRING_PROFILES_ACTIVE=local   # dev machine — scanner allows private,
#                                    #   DEBUG logging, looser rate limits
#     SPRING_PROFILES_ACTIVE=dev     # staging VPS — production-safe defaults,
#                                    #   INFO logging
#     SPRING_PROFILES_ACTIVE=prod    # production — strict SSRF guard, WARN
#                                    #   logging, persistent demo keys path
#
# Behaviour per profile is in src/main/resources/application-{local,dev,prod}.yml.
# Secrets always come from env vars below — never check them into yml.
SPRING_PROFILES_ACTIVE=local

# ───── Demo-request notification email ──────────────────────────────────────
# When a customer submits the Request Demo modal, the BE sends a signed
# notification email via these credentials. Without them, send fails
# silently (BE logs a warn at WARN level; user still sees "Submitted").
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USER_NAME=
SMTP_PASSWORD=
# Gmail requires an App Password, not your account password:
#   myaccount.google.com → Security → 2-step Verification → App passwords

# ───── Demo-request routing ─────────────────────────────────────────────────
DEMO_NOTIFY_FROM=noreply@zenv.ai
# Double-quote values that contain shell-special chars like (, ),
# spaces, $, backticks. zsh otherwise parses `Foo (Bar)` as a glob
# qualifier and `set -a; source .env` fails with "unknown file attribute".
DEMO_NOTIFY_FROM_NAME="Qudo PQC (ZenV Quantum)"
# All demo notifications land in this inbox — not whatever email the
# customer typed into the form.
DEMO_NOTIFY_TO=john@zenv.ai

# ───── Demo-request signing-key persistence ─────────────────────────────────
# Where ML-DSA-65 demo-notification signing keys live across BE restarts.
# Default is ./keys (gitignored). Change in prod to /var/lib/qudo/keys
# or similar persistent location.
DEMO_KEYS_DIR=./keys

# ───── Frontend ─────────────────────────────────────────────────────────────
# CORS allow-list + the only origin permitted to call the API. Vite dev
# server uses 5173.
FRONTEND_ORIGIN=http://localhost:5173

# ───── Database (product catalog + audit) ───────────────────────────────────
# Postgres is now REQUIRED — the backend is the source of truth for which
# products are publicly visible. Start it locally with `docker compose up -d`.
# These defaults match docker-compose.yml; set real values per deployment.
DB_URL=jdbc:postgresql://localhost:5432/qudo_portal
DB_NAME=qudo_portal
DB_USERNAME=qudo
DB_PASSWORD=qudo_local_dev

# ───── Admin (product-management API) ────────────────────────────────────────
# The single administrator credential for /api/v1/admin/**. The password is a
# BCrypt HASH, never plaintext, and is never committed. dev/prod FAIL TO START
# unless BOTH are set; the `local` profile ships a dev-only default
# (admin / qudo-admin-dev) that is never used in a deployment.
#   Generate a hash (macOS/Linux with Apache tools):
#     htpasswd -nbBC 10 "" 'your-password' | cut -d: -f2
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ───── Scanner / rate-limit overrides (uncomment to tune) ──────────────────
# The profile YAML files set sensible per-environment defaults. Override
# any of these per-deploy if needed.
# APP_SCANNER_ALLOW_PRIVATE=true         # default true under local, false elsewhere
# APP_RATELIMIT_SANDBOX_RPM=60
# APP_RATELIMIT_SCANNER_RPM=10
# APP_RATELIMIT_DEMO_RPM=5
